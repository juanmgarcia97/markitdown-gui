{
  "name": "markitdown-gui",
  "productName": "MarkItDown GUI",
  "version": "1.0.0",
  "description": "Aplicación de escritorio GUI para la librería markitdown de Microsoft",
  "main": ".webpack/main",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "setup-python": "node scripts/setup-python.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "markitdown",
    "markdown",
    "converter",
    "electron",
    "gui"
  ],
  "author": "Juan Martin Garcia",
  "license": "MIT",
  "dependencies": {
    "dompurify": "^3.4.12",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^11.0.2",
    "file-type": "^22.0.1",
    "marked": "^18.0.7"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.4.0",
    "@electron-forge/maker-dmg": "^7.4.0",
    "@electron-forge/maker-squirrel": "^7.4.0",
    "@electron-forge/plugin-webpack": "^7.4.0",
    "@vercel/webpack-asset-relocator-loader": "^1.7.4",
    "@vitest/coverage-v8": "^4.1.10",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "electron": "^33.4.11",
    "fast-check": "^4.9.0",
    "jsdom": "^29.1.1",
    "node-loader": "^2.0.0",
    "style-loader": "^4.0.0",
    "tar": "^7.5.22",
    "vitest": "^4.1.10"
  }
}
